{
  "name": "offline-multiplayer-ludo-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b --noEmit",
    "screenshot": "node scripts/screenshot.mjs http://localhost:4173 ../docs/screenshots",
    "e2e": "node scripts/e2e-passplay.mjs http://localhost:4173",
    "anim-check": "node scripts/anim-check.mjs http://localhost:4173 ../docs/screenshots",
    "sound-check": "node scripts/sound-check.mjs http://localhost:4173",
    "bot-soak": "node scripts/bot-soak.mjs http://localhost:4173",
    "check:all": "npm run lint && npm run typecheck && npm test && npm run build",
    "lan-check": "node scripts/lan-check.mjs ../server/target/debug/ludo-server 7979",
    "icons": "node scripts/make-icons.mjs ../tauri/icons"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
