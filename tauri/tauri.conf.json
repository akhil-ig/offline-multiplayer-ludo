{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ludo",
  "version": "0.1.0",
  "identifier": "io.github.akhilig.ludo",
  "build": {
    "frontendDist": "http://127.0.0.1:7878",
    "devUrl": "http://127.0.0.1:7878"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ludo",
        "label": "main",
        "width": 430,
        "height": 900,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "Offline multiplayer Ludo for phones",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
