<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks to its own embedded server over plain HTTP on the loopback
     interface. Android blocks cleartext by default on targetSdk >= 28, so allow
     it for loopback only. Friends' phones use their own browsers, not this app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
